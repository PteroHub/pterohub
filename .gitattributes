# Default: preserve Linux line endings
* text=auto

# Configuration and source files
*.php text eol=lf
*.env* text eol=lf
*.sh text eol=lf
*.js text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary